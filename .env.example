# --- Base de datos (Neon) ---
# DATABASE_URL: la cadena CON pooling (tiene "-pooler" en el host) - la usa la app en producción.
# DIRECT_URL: la cadena SIN pooling - la usa Prisma solo para aplicar migraciones.
# Ambas se consiguen en el dashboard de Neon → Connect → Postgres database.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Autenticación de la API ---
JWT_SECRET="cambia_esto_por_un_valor_largo_y_aleatorio"

# --- Microsoft Graph (envío de correo desde Microsoft 365) ---
# Estos 3 valores los genera el administrador de Microsoft 365 al registrar
# la aplicación en Entra ID (ver README.md, sección "Configurar Microsoft 365").
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
# Buzón desde el que se enviarán los correos, ej. ti@fitnessparatodos.com
GRAPH_SENDER_MAILBOX=""

# --- General ---
PORT=3000
CORS_ORIGIN="*"
